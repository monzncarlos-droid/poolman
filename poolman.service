[Unit]
Description=Poolman Mining Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/poolman
# BTC_ADDRESS is read from the .env file in WorkingDirectory (via python-dotenv).
# Do not set it here with Environment= — that would override the .env value.
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
